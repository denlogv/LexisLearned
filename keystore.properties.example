# Copy this file to keystore.properties (it is git-ignored) and fill in your values.
# Only NON-secret values belong here. The passwords are never stored in the repository:
# see "Signing" in docs/RELEASING.md (tools/setup-release-signing.sh sets everything up).
storeFile=/absolute/path/to/your-release-keystore.jks
keyAlias=your-key-alias
